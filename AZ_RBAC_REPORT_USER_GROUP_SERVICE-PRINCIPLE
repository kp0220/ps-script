# ============================================================
# Azure RBAC + PIM Report
#
# INPUT CSV:
#
# subscription,subscriptionid,user/group/serviceprinciple
#
# Example:
#
# Connectivity,8a79fe1c-45c1-4fb6-81df-5fa1b9f0a3d8,a-MRWellborn
# Dev-Test,b14faae7-cd5f-4fdb-857d-7b55a3131809,a-MRWellborn
# ExpressRoute,1bba1dad-c588-476a-ac2a-11a7ab9fd3bd,a-JJBode
#
#
# CHECKS:
#
# 1. Normal / Permanent Azure RBAC
# 2. PIM Eligible Azure RBAC
# 3. PIM Active / Time-Bound Azure RBAC
# 4. Management Group Normal RBAC
# 5. Management Group PIM Eligible
# 6. Management Group PIM Active / Time-Bound
#
#
# SUPPORTED OBJECTS:
#
# - User
# - Security Group
# - Service Principal
#
#
# OUTPUT:
#
# - InputSubscription
# - SubscriptionId
# - ObjectName
# - ObjectType
# - ObjectId
# - DuplicateObject
# - RoleName
# - AssignmentType
# - AssignmentStatus
# - Scope
# - ScopeType
# - ScopeName
# - Inherited
# - AssignmentSource
# - StartDateTime
# - EndDateTime
# - Management Group information
# - Status
#
# ============================================================


# ============================================================
# CONFIGURATION
# ============================================================

$InputCsv  = "C:\Temp\UserSubscriptions_1.csv"

$OutputCsv = "C:\Temp\Azure-RBAC-PIM-Report_1.csv"


# ============================================================
# REQUIRED MODULES
# ============================================================

# Install once if required:
#
# Install-Module Az.Accounts -Scope CurrentUser
# Install-Module Az.Resources -Scope CurrentUser
#
# ============================================================


if (-not (Get-Module -ListAvailable -Name Az.Accounts)) {

    throw "Az.Accounts module is not installed. Run: Install-Module Az.Accounts -Scope CurrentUser"
}


if (-not (Get-Module -ListAvailable -Name Az.Resources)) {

    throw "Az.Resources module is not installed. Run: Install-Module Az.Resources -Scope CurrentUser"
}


Import-Module Az.Accounts
Import-Module Az.Resources


# ============================================================
# LOGIN
# ============================================================

Write-Host ""
Write-Host "========================================================" `
    -ForegroundColor Cyan

Write-Host "Connecting to Azure..." `
    -ForegroundColor Cyan

Write-Host "========================================================" `
    -ForegroundColor Cyan


Connect-AzAccount


# ============================================================
# IMPORT INPUT CSV
# ============================================================

if (-not (Test-Path $InputCsv)) {

    throw "Input CSV not found: $InputCsv"
}


$InputRows = @(
    Import-Csv -Path $InputCsv
)


if ($InputRows.Count -eq 0) {

    throw "Input CSV is empty."
}


# ============================================================
# NORMALIZE CSV HEADER NAMES
# ============================================================

foreach ($Row in $InputRows) {

    foreach ($Property in @($Row.PSObject.Properties)) {

        $CleanName =
            $Property.Name.Trim()


        if ($CleanName -ne $Property.Name) {

            $Value =
                $Property.Value


            $Row.PSObject.Properties.Remove(
                $Property.Name
            )


            $Row |
                Add-Member `
                    -NotePropertyName $CleanName `
                    -NotePropertyValue $Value
        }
    }
}


# ============================================================
# REQUIRED CSV COLUMNS
# ============================================================

$RequiredColumns = @(
    "subscription",
    "subscriptionid",
    "user/group/serviceprinciple"
)


$CsvColumns =
    @(
        $InputRows[0].PSObject.Properties.Name
    )


foreach ($RequiredColumn in $RequiredColumns) {

    if ($RequiredColumn -notin $CsvColumns) {

        throw `
            "Required CSV column missing: [$RequiredColumn]"
    }
}


# ============================================================
# DEBUG - SHOW INPUT
# ============================================================

Write-Host ""
Write-Host "========================================================" `
    -ForegroundColor Cyan

Write-Host "INPUT CSV VALIDATION" `
    -ForegroundColor Cyan

Write-Host "========================================================" `
    -ForegroundColor Cyan


Write-Host ""
Write-Host "Input file:" `
    -ForegroundColor Yellow

Write-Host $InputCsv


Write-Host ""
Write-Host "Input rows: $($InputRows.Count)" `
    -ForegroundColor Yellow


Write-Host ""
Write-Host "CSV columns:" `
    -ForegroundColor Yellow


foreach ($Column in $CsvColumns) {

    Write-Host "  [$Column]"
}


Write-Host ""
Write-Host "Input data:" `
    -ForegroundColor Yellow


foreach ($Row in $InputRows) {

    Write-Host ""
    Write-Host "  Subscription : $($Row.subscription)"
    Write-Host "  SubscriptionId: $($Row.subscriptionid)"
    Write-Host "  Object       : $($Row.'user/group/serviceprinciple')"
}


# ============================================================
# RESULTS
# ============================================================

$Results = @()


# ============================================================
# CACHES
# ============================================================

$RoleDefinitionCache = @{}

$SubscriptionManagementGroupCache = @{}


# ============================================================
# DUPLICATE OBJECT COUNT
# ============================================================

$ObjectOccurrenceMap = @{}


foreach ($Row in $InputRows) {

    $ObjectName =
        $Row."user/group/serviceprinciple"


    if ($null -eq $ObjectName) {

        continue
    }


    $ObjectName =
        $ObjectName.Trim()


    if ([string]::IsNullOrWhiteSpace($ObjectName)) {

        continue
    }


    $ObjectKey =
        $ObjectName.ToLower()


    if ($ObjectOccurrenceMap.ContainsKey($ObjectKey)) {

        $ObjectOccurrenceMap[$ObjectKey]++
    }
    else {

        $ObjectOccurrenceMap[$ObjectKey] = 1
    }
}


# ============================================================

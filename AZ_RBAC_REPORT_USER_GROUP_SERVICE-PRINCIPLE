                $DisplayName

            ObjectType =
                $ObjectType

            ObjectId =
                $ObjectId

            UserPrincipalName =
                $UserPrincipalName

            AppId =
                $AppId


            SubscriptionName =
                $SubscriptionName

            SubscriptionId =
                $SubscriptionId


            RoleName =
                $RoleName

            RoleDefinitionId =
                $RoleDefinitionId

            RoleDescription =
                $RoleDescription


            AssignmentId =
                $AssignmentId

            AssignmentObjectType =
                $AssignmentObjectType

            AssignmentType =
                $AssignmentType

            AssignmentStatus =
                $AssignmentStatus


            Scope =
                $Scope

            ScopeType =
                $ScopeType

            ScopeName =
                $ScopeName


            Inherited =
                $Inherited

            AssignmentSource =
                $AssignmentSource


            StartDateTime =
                $StartDateTime

            EndDateTime =
                $EndDateTime


            ManagementGroupName =
                $ManagementGroupName

            ManagementGroupDisplayName =
                $ManagementGroupDisplayName


            Status =
                $Status
        }
}


# ============================================================
# FUNCTION
#
# GET ROLE DEFINITION
#
# ============================================================

function Get-CachedRoleDefinition {

    param(

        [Parameter(Mandatory = $true)]
        [string]
        $RoleDefinitionId
    )


    if (
        [string]::IsNullOrWhiteSpace(
            $RoleDefinitionId
        )
    ) {

        return $null
    }


    $Key =
        $RoleDefinitionId.ToLower()


    if (
        $RoleDefinitionCache.ContainsKey($Key)
    ) {

        return $RoleDefinitionCache[$Key]
    }


    try {

        $RoleDefinition =
            Get-AzRoleDefinition `
                -Id $RoleDefinitionId `
                -ErrorAction Stop


        $RoleDefinitionCache[$Key] =
            $RoleDefinition


        return $RoleDefinition
    }
    catch {

        $RoleDefinitionCache[$Key] =
            $null


        return $null
    }
}


# ============================================================
# FUNCTION
#
# DETERMINE SCOPE TYPE
#
# ============================================================

function Get-ScopeInformation {

    param(

        [string]$Scope,

        [string]$SubscriptionName
    )


    if ([string]::IsNullOrWhiteSpace($Scope)) {

        return [PSCustomObject]@{

            ScopeType = ""

            ScopeName = ""
        }
    }


    # --------------------------------------------------------
    # MANAGEMENT GROUP
    # --------------------------------------------------------

    if (
        $Scope -match `
        "^/providers/Microsoft\.Management/managementGroups/"
    ) {

        return [PSCustomObject]@{

            ScopeType =
                "Management Group"

            ScopeName =
                ($Scope -split "/")[-1]
        }
    }


    # --------------------------------------------------------
    # SUBSCRIPTION
    # --------------------------------------------------------

    if (
        $Scope -match `
        "^/subscriptions/[^/]+$"
    ) {

        return [PSCustomObject]@{

            ScopeType =
                "Subscription"

            ScopeName =
                $SubscriptionName
        }
    }


    # --------------------------------------------------------
    # RESOURCE GROUP
    # --------------------------------------------------------

    if (
        $Scope -match `
        "^/subscriptions/[^/]+/resourceGroups/([^/]+)$"
    ) {

        return [PSCustomObject]@{

            ScopeType =
                "Resource Group"

            ScopeName =
                $Matches[1]
        }
    }


    # --------------------------------------------------------
    # RESOURCE
    # --------------------------------------------------------

    if (
        $Scope -match "/providers/"
    ) {

        return [PSCustomObject]@{

            ScopeType =
                "Resource"

            ScopeName =
                ($Scope -split "/")[-1]
        }
    }


    return [PSCustomObject]@{

        ScopeType =
            "Other"

        ScopeName =
            $Scope
    }
}


# ============================================================
# GET MANAGEMENT GROUPS
# ============================================================

Write-Host ""
Write-Host "========================================================" `
    -ForegroundColor Cyan

Write-Host "Building Management Group hierarchy..." `
    -ForegroundColor Cyan

Write-Host "========================================================" `
    -ForegroundColor Cyan


$ManagementGroups = @()


try {

    $ManagementGroups = @(
        Get-AzManagementGroup `
            -ErrorAction Stop
    )


    Write-Host `
        "Management Groups discovered: $($ManagementGroups.Count)" `
        -ForegroundColor Green
}
catch {

    Write-Warning `
        "Unable to retrieve Management Groups: $($_.Exception.Message)"

    Write-Warning `
        "Management Group checks will be skipped."
}


# ============================================================
# MANAGEMENT GROUP LOOKUP
# ============================================================

$ManagementGroupLookup = @{}


foreach ($ManagementGroup in $ManagementGroups) {

    if (
        -not [string]::IsNullOrWhiteSpace(
            $ManagementGroup.Id
        )
    ) {

        $ManagementGroupLookup[
            $ManagementGroup.Id.ToLower()
        ] =
            $ManagementGroup
    }
}


# ============================================================
# FUNCTION
#
# GET MANAGEMENT GROUPS FOR SUBSCRIPTION
#
# ============================================================

function Get-ManagementGroupsForSubscription {

    param(

        [Parameter(Mandatory = $true)]
        [string]
        $SubscriptionId
    )


    $CacheKey =
        $SubscriptionId.ToLower()


    if (
        $SubscriptionManagementGroupCache.ContainsKey(
            $CacheKey
        )
    ) {

        return @(
            $SubscriptionManagementGroupCache[$CacheKey]
        )
    }


    $Result = @()

    $CurrentManagementGroup = $null


    # --------------------------------------------------------
    # FIND DIRECT MANAGEMENT GROUP
    # --------------------------------------------------------

    foreach ($ManagementGroup in $ManagementGroups) {

        try {

            $Membership =
                Get-AzManagementGroupSubscription `
                    -GroupName $ManagementGroup.Name `
                    -SubscriptionId $SubscriptionId `
                    -ErrorAction Stop


            if ($null -ne $Membership) {

                $CurrentManagementGroup =
                    $ManagementGroup

                break
            }
        }
        catch {

            continue
        }
    }


    # --------------------------------------------------------
    # NO MANAGEMENT GROUP
    # --------------------------------------------------------

    if ($null -eq $CurrentManagementGroup) {

        $SubscriptionManagementGroupCache[
            $CacheKey
        ] = @()


        return @()
    }


    # --------------------------------------------------------
    # WALK UP HIERARCHY
    # --------------------------------------------------------

    $Visited = @{}


    while ($null -ne $CurrentManagementGroup) {

        $CurrentId =
            $CurrentManagementGroup.Id.ToLower()


        if (
            $Visited.ContainsKey($CurrentId)
        ) {

            break
        }


        $Visited[$CurrentId] =
            $true


        $Result +=
            $CurrentManagementGroup


        $ParentId =
            $CurrentManagementGroup.ParentId


        if (
            [string]::IsNullOrWhiteSpace($ParentId)
        ) {

            break
        }


        if (
            $ParentId -notmatch `
            "^/providers/Microsoft\.Management/managementGroups/"
        ) {

            break
        }


        $ParentKey =
            $ParentId.ToLower()


        if (
            $ManagementGroupLookup.ContainsKey(
                $ParentKey
            )
        ) {

            $CurrentManagementGroup =
                $ManagementGroupLookup[$ParentKey]
        }
        else {

            try {

                $ParentName =
                    ($ParentId -split "/")[-1]


                $CurrentManagementGroup =
                    Get-AzManagementGroup `
                        -GroupName $ParentName `
                        -ErrorAction Stop
            }
            catch {

                break
            }
        }
    }


    $SubscriptionManagementGroupCache[
        $CacheKey
    ] =
        @($Result)


    return @($Result)
}


# ============================================================
# PROCESS EACH INPUT ROW
# ============================================================

foreach ($Row in $InputRows) {

    # ========================================================
    # READ INPUT VALUES
    # ========================================================

    $InputSubscription =
        [string]$Row.subscription


    $InputSubscription =
        $InputSubscription.Trim()


    $SubscriptionId =
        [string]$Row.subscriptionid


    $SubscriptionId =
        $SubscriptionId.Trim()


    $DisplayName =
        [string]$Row."user/group/serviceprinciple"


    $DisplayName =
        $DisplayName.Trim()


    # ========================================================
    # DEBUG
    # ========================================================

    Write-Host ""
    Write-Host "========================================================" `
        -ForegroundColor Cyan

    Write-Host "INPUT ROW" `
        -ForegroundColor Cyan

    Write-Host "Subscription : [$InputSubscription]" `
        -ForegroundColor Yellow

    Write-Host "SubscriptionId: [$SubscriptionId]" `
        -ForegroundColor Yellow

    Write-Host "Object       : [$DisplayName]" `
        -ForegroundColor Yellow

    Write-Host "========================================================" `
        -ForegroundColor Cyan


    # ========================================================
    # VALIDATE INPUT
    # ========================================================

    if (
        [string]::IsNullOrWhiteSpace(
            $InputSubscription
        )
    ) {

        Write-Warning `
            "Subscription name is empty. Skipping row."

        continue
    }


    if (
        [string]::IsNullOrWhiteSpace(
            $SubscriptionId
        )
    ) {

        Write-Warning `
            "SubscriptionId is empty. Skipping row."

        continue
    }


    if (
        [string]::IsNullOrWhiteSpace(
            $DisplayName
        )
    ) {

        Write-Warning `
            "Object name is empty. Skipping row."

        continue
    }


    # ========================================================
    # DUPLICATE OBJECT
    # ========================================================

    $ObjectKey =
        $DisplayName.ToLower()


    $DuplicateObject =
        "NO"


    if (
        $ObjectOccurrenceMap.ContainsKey(
            $ObjectKey
        ) -and

        $ObjectOccurrenceMap[$ObjectKey] -gt 1
    ) {

        $DuplicateObject =
            "YES"
    }


    # ========================================================
    # FIND USERS
    # ========================================================

    Write-Host ""
    Write-Host `
        "Searching User: $DisplayName" `
        -ForegroundColor DarkCyan


    $Users = @(
        Get-AzADUser `
            -DisplayName $DisplayName `
            -ErrorAction SilentlyContinue
    )


    # ========================================================
    # FIND GROUPS
    # ========================================================

    Write-Host `
        "Searching Group: $DisplayName" `
        -ForegroundColor DarkCyan


    $Groups = @(
        Get-AzADGroup `
            -DisplayName $DisplayName `
            -ErrorAction SilentlyContinue
    )


    # ========================================================
    # FIND SERVICE PRINCIPALS
    # ========================================================

    Write-Host `
        "Searching Service Principal: $DisplayName" `
        -ForegroundColor DarkCyan


    $ServicePrincipals = @(
        Get-AzADServicePrincipal `
            -DisplayName $DisplayName `
            -ErrorAction SilentlyContinue
    )


    # ========================================================
    # COMBINE OBJECTS
    # ========================================================

    $MatchedObjects = @()


    # --------------------------------------------------------
    # USERS
    # --------------------------------------------------------

    foreach ($User in $Users) {

        $MatchedObjects +=
            [PSCustomObject]@{

                ObjectType =
                    "User"

                DisplayName =
                    $User.DisplayName

                ObjectId =
                    $User.Id

                UserPrincipalName =
                    $User.UserPrincipalName

                AppId =
                    ""
            }
    }


    # --------------------------------------------------------
    # GROUPS
    # --------------------------------------------------------

    foreach ($Group in $Groups) {

        $MatchedObjects +=
            [PSCustomObject]@{

                ObjectType =
                    "Group"

                DisplayName =
                    $Group.DisplayName

                ObjectId =
                    $Group.Id

                UserPrincipalName =
                    ""

                AppId =
                    ""
            }
    }


    # --------------------------------------------------------
    # SERVICE PRINCIPALS
    # --------------------------------------------------------

    foreach ($ServicePrincipal in $ServicePrincipals) {

        $MatchedObjects +=
            [PSCustomObject]@{

                ObjectType =
                    "ServicePrincipal"

                DisplayName =
                    $ServicePrincipal.DisplayName

                ObjectId =
                    $ServicePrincipal.Id

                UserPrincipalName =
                    ""

                AppId =
                    $ServicePrincipal.AppId
            }
    }


    # ========================================================
    # OBJECT NOT FOUND
    # ========================================================

    if ($MatchedObjects.Count -eq 0) {

        Write-Warning `
            "Object not found: $DisplayName"


        Add-Result `
            -InputSubscription $InputSubscription `
            -DuplicateObject $DuplicateObject `
            -ObjectName $DisplayName `
            -DisplayName $DisplayName `
            -ObjectType "Not Found" `
            -ObjectId "" `
            -UserPrincipalName "" `
            -AppId "" `
            -SubscriptionName "" `
            -SubscriptionId $SubscriptionId `
            -RoleName "" `
            -RoleDefinitionId "" `
            -RoleDescription "" `
            -AssignmentId "" `
            -AssignmentObjectType "" `
            -AssignmentType "" `
            -AssignmentStatus "" `
            -Scope "" `
            -ScopeType "" `
            -ScopeName "" `
            -Inherited "" `
            -AssignmentSource "" `
            -StartDateTime "" `
            -EndDateTime "" `
            -ManagementGroupName "" `
            -ManagementGroupDisplayName "" `
            -Status "OBJECT NOT FOUND"


        continue
    }


    # ========================================================
    # MULTIPLE OBJECTS FOUND
    # ========================================================

    if ($MatchedObjects.Count -gt 1) {

        Write-Warning `
            "Multiple objects found for: $DisplayName"


        foreach ($Object in $MatchedObjects) {

            Write-Host `
                "  $($Object.ObjectType) - $($Object.ObjectId)" `
                -ForegroundColor Yellow


            Add-Result `
                -InputSubscription $InputSubscription `
                -DuplicateObject $DuplicateObject `
                -ObjectName $DisplayName `
                -DisplayName $Object.DisplayName `
                -ObjectType $Object.ObjectType `
                -ObjectId $Object.ObjectId `
                -UserPrincipalName $Object.UserPrincipalName `
                -AppId $Object.AppId `
                -SubscriptionName "" `
                -SubscriptionId $SubscriptionId `
                -RoleName "" `
                -RoleDefinitionId "" `
                -RoleDescription "" `
                -AssignmentId "" `
                -AssignmentObjectType "" `
                -AssignmentType "" `
                -AssignmentStatus "" `
                -Scope "" `
                -ScopeType "" `
                -ScopeName "" `
                -Inherited "" `
                -AssignmentSource "" `
                -StartDateTime "" `
                -EndDateTime "" `
                -ManagementGroupName "" `
                -ManagementGroupDisplayName "" `
                -Status "MULTIPLE OBJECTS FOUND"
        }


        continue
    }


    # ========================================================
    # SINGLE OBJECT
    # ========================================================

    $Object =
        $MatchedObjects[0]


    Write-Host ""
    Write-Host `
        "OBJECT FOUND" `
        -ForegroundColor Green

    Write-Host `
        "Type       : $($Object.ObjectType)" `
        -ForegroundColor Green

    Write-Host `
        "DisplayName: $($Object.DisplayName)" `
        -ForegroundColor Green

    Write-Host `
        "ObjectId   : $($Object.ObjectId)" `
        -ForegroundColor Green


    # ========================================================
    # SET SUBSCRIPTION CONTEXT
    # ========================================================

    Write-Host ""
    Write-Host `
        "Setting Azure subscription context..." `
        -ForegroundColor Yellow


    try {

        Set-AzContext `
            -SubscriptionId $SubscriptionId `
            -ErrorAction Stop |
            Out-Null


        $Context =
            Get-AzContext


        $SubscriptionName =
            $Context.Subscription.Name


        Write-Host `
            "Context set successfully: $SubscriptionName" `
            -ForegroundColor Green
    }
    catch {

        Write-Warning `
            "Unable to set subscription context: $SubscriptionId"

        Write-Warning `
            $_.Exception.Message


        Add-Result `
            -InputSubscription $InputSubscription `
            -DuplicateObject $DuplicateObject `
            -ObjectName $DisplayName `
            -DisplayName $Object.DisplayName `
            -ObjectType $Object.ObjectType `
            -ObjectId $Object.ObjectId `
            -UserPrincipalName $Object.UserPrincipalName `
            -AppId $Object.AppId `
            -SubscriptionName "" `
            -SubscriptionId $SubscriptionId `
            -RoleName "" `
            -RoleDefinitionId "" `
            -RoleDescription "" `
            -AssignmentId "" `
            -AssignmentObjectType "" `
            -AssignmentType "" `
            -AssignmentStatus "" `
            -Scope "" `
            -ScopeType "" `
            -ScopeName "" `
            -Inherited "" `
            -AssignmentSource "" `
            -StartDateTime "" `
            -EndDateTime "" `
            -ManagementGroupName "" `
            -ManagementGroupDisplayName "" `
            -Status "ERROR SETTING SUBSCRIPTION CONTEXT: $($_.Exception.Message)"


        continue
    }


    # ========================================================
    # TRACK ASSIGNMENTS
    # ========================================================

    $FoundAssignment =
        $false


    # ========================================================
    # SUBSCRIPTION SCOPE
    # ========================================================

    $SubscriptionScope =
        "/subscriptions/$SubscriptionId"


    # ========================================================
    # 1. NORMAL RBAC
    # ========================================================

    Write-Host ""
    Write-Host `
        "--------------------------------------------------------" `
        -ForegroundColor DarkGray

    Write-Host `
        "CHECKING NORMAL / PERMANENT RBAC" `
        -ForegroundColor Yellow

    Write-Host `
        "--------------------------------------------------------" `
        -ForegroundColor DarkGray


    try {

        $NormalAssignments = @(
            Get-AzRoleAssignment `
                -ObjectId $Object.ObjectId `
                -ErrorAction Stop |
            Where-Object {

                $_.Scope -like `
                    "$SubscriptionScope*"
            }
        )


        $NormalAssignments =
            @(
                $NormalAssignments |
                Sort-Object RoleAssignmentId -Unique
            )


        Write-Host `
            "Normal assignments found: $($NormalAssignments.Count)" `
            -ForegroundColor Cyan


        foreach ($Assignment in $NormalAssignments) {

            $FoundAssignment =
                $true


            Write-Host `
                "  NORMAL RBAC: $($Assignment.RoleDefinitionName)" `
                -ForegroundColor Green


            $RoleDefinition =
                Get-CachedRoleDefinition `
                    -RoleDefinitionId `
                    $Assignment.RoleDefinitionId


            $RoleDescription = ""


            if ($null -ne $RoleDefinition) {

                $RoleDescription =
                    $RoleDefinition.Description
            }


            $ScopeInfo =
                Get-ScopeInformation `
                    -Scope $Assignment.Scope `
                    -SubscriptionName $SubscriptionName


            Add-Result `
                -InputSubscription $InputSubscription `
                -DuplicateObject $DuplicateObject `
                -ObjectName $DisplayName `
                -DisplayName $Object.DisplayName `
                -ObjectType $Object.ObjectType `
                -ObjectId $Object.ObjectId `
                -UserPrincipalName $Object.UserPrincipalName `
                -AppId $Object.AppId `
                -SubscriptionName $SubscriptionName `
                -SubscriptionId $SubscriptionId `
                -RoleName $Assignment.RoleDefinitionName `
                -RoleDefinitionId $Assignment.RoleDefinitionId `
                -RoleDescription $RoleDescription `
                -AssignmentId $Assignment.RoleAssignmentId `
                -AssignmentObjectType $Assignment.ObjectType `
                -AssignmentType "Normal / Permanent" `
                -AssignmentStatus "Active" `
                -Scope $Assignment.Scope `
                -ScopeType $ScopeInfo.ScopeType `
                -ScopeName $ScopeInfo.ScopeName `
                -Inherited "No" `
                -AssignmentSource $ScopeInfo.ScopeType `
                -StartDateTime "" `
                -EndDateTime "" `
                -ManagementGroupName "" `
                -ManagementGroupDisplayName "" `
                -Status "SUCCESS - NORMAL RBAC"
        }
    }
    catch {

        Write-Warning `
            "Normal RBAC query failed: $($_.Exception.Message)"
    }


    # ========================================================
    # 2. PIM ELIGIBLE
    # ========================================================

    Write-Host ""
    Write-Host `
        "--------------------------------------------------------" `
        -ForegroundColor DarkGray

    Write-Host `
        "CHECKING PIM ELIGIBLE RBAC" `
        -ForegroundColor Magenta

    Write-Host `
        "--------------------------------------------------------" `
        -ForegroundColor DarkGray


    try {

        $EligibleAssignments = @(
            Get-AzRoleEligibilitySchedule `
